+// QT_WAYLAND_MOUSE_AS_TOUCH=1 delivers the left mouse button as a single touch
+// point, for an interface that only acts on touch (Engine) driven with a mouse
+// under a compositor. Hover and the other buttons stay mouse events. local and
+// global are the window's own: with Qt drawing the frame (bradient, where the
+// compositor will not, as on GNOME) they are the surface's less its margins.
+static bool deliverMouseAsTouch(QWindow *window, const QWaylandPointerEvent &e,
+                                const QPointF &local, const QPointF &global)
+{
+    static const bool enabled = qEnvironmentVariableIntValue("QT_WAYLAND_MOUSE_AS_TOUCH");
+    if (!enabled || !window->handle())
+        return false;
+    static QTouchDevice *device = [] {
+        auto *d = new QTouchDevice;
+        d->setName(QStringLiteral("mouse as touch"));
+        d->setType(QTouchDevice::TouchScreen);
+        d->setCapabilities(QTouchDevice::Position | QTouchDevice::Area
+                           | QTouchDevice::NormalizedPosition);
+        d->setMaximumTouchPoints(1);
+        QWindowSystemInterface::registerTouchDevice(d);
+        return d;
+    }();
+    static bool down = false;
+
+    Qt::TouchPointState state;
+    if (e.type == QEvent::MouseButtonPress && e.button == Qt::LeftButton) {
+        if (down)
+            return true;
+        down = true;
+        state = Qt::TouchPointPressed;
+    } else if (e.type == QEvent::MouseButtonRelease && e.button == Qt::LeftButton) {
+        if (!down)
+            return true;
+        down = false;
+        state = Qt::TouchPointReleased;
+    } else if (e.type == QEvent::MouseMove && down) {
+        state = Qt::TouchPointMoved;
+    } else {
+        return false;
+    }
+
+    const QRect geometry = window->handle()->geometry();
+    QWindowSystemInterface::TouchPoint point;
+    point.id = 0;
+    point.state = state;
+    point.pressure = state == Qt::TouchPointReleased ? 0 : 1;
+    point.area = QRectF(global - QPointF(4, 4), QSizeF(8, 8));
+    point.normalPosition = QPointF(local.x() / qMax(1, geometry.width()),
+                                   local.y() / qMax(1, geometry.height()));
+    QWindowSystemInterface::handleTouchEvent(window, e.timestamp, device, { point }, e.modifiers);
+    return true;
+}
