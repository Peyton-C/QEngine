+// QT_WAYLAND_MOUSE_AS_TOUCH=1 delivers the left mouse button as a single touch
+// point, for an interface that only acts on touch (Engine) driven with a mouse
+// under a compositor. Hover and the other buttons stay mouse events.
+static bool deliverMouseAsTouch(QWindow *window, const QWaylandPointerEvent &e)
+{
+    static const bool enabled = qEnvironmentVariableIntValue("QT_WAYLAND_MOUSE_AS_TOUCH");
+    if (!enabled || !window->handle())
+        return false;
+    static QPointingDevice *device = [] {
+        auto *d = new QPointingDevice(QStringLiteral("mouse as touch"), 0x6d6174,
+                                      QInputDevice::DeviceType::TouchScreen,
+                                      QPointingDevice::PointerType::Finger,
+                                      QInputDevice::Capability::Position
+                                              | QInputDevice::Capability::Area,
+                                      1, 0);
+        QWindowSystemInterface::registerInputDevice(d);
+        return d;
+    }();
+    static bool down = false;
+
+    QEventPoint::State state;
+    if (e.type == QEvent::MouseButtonPress && e.button == Qt::LeftButton) {
+        if (down)
+            return true;
+        down = true;
+        state = QEventPoint::State::Pressed;
+    } else if (e.type == QEvent::MouseButtonRelease && e.button == Qt::LeftButton) {
+        if (!down)
+            return true;
+        down = false;
+        state = QEventPoint::State::Released;
+    } else if (e.type == QEvent::MouseMove && down) {
+        state = QEventPoint::State::Updated;
+    } else {
+        return false;
+    }
+
+    const QRect geometry = window->handle()->geometry();
+    QWindowSystemInterface::TouchPoint point;
+    point.id = 0;
+    point.state = state;
+    point.pressure = state == QEventPoint::State::Released ? 0 : 1;
+    point.area = QRectF(e.global - QPointF(4, 4), QSizeF(8, 8));
+    point.normalPosition = QPointF(e.local.x() / qMax(1, geometry.width()),
+                                   e.local.y() / qMax(1, geometry.height()));
+    QWindowSystemInterface::handleTouchEvent(window, e.timestamp, device, { point }, e.modifiers);
+    return true;
+}
