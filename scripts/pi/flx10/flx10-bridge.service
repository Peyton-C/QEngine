[Unit]
Description=DDJ-FLX10 jog screens for Engine
After=qengine.service

[Service]
# The bridge waits for the controller and for Engine's mod on its own, so it
# can start before either and survive both coming and going.
# FLX10_PORT in pi.env: which of the controller's two USB ports is Engine's.
EnvironmentFile=-@QENGINE_DIR@/pi.env
ExecStart=/usr/bin/python3 -I -u @QENGINE_DIR@/flx10/flx10_bridge.py --squeeze --port=${FLX10_PORT}
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
