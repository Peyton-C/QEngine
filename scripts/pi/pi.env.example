# pi.env — settings for chroot-up.sh and chroot-engine.sh on one Pi.
# Copy to ~/qengine/pi.env (next to rootfs.img) and edit; both scripts read it.
# Every line is optional. chroot-engine.sh documents each variable.

# Sound card by ALSA id, from the brackets in /proc/asound/cards. vc4hdmi0 and
# vc4hdmi1 are the monitors on HDMI-A-1 and HDMI-A-2.
#AUDIO_CARD=Headset
# A second card for the headphone cue, and the first channel of that output.
#CUE_CARD=H630
#CUE_CHANNEL=3

# Display. The connector defaults to the first connected HDMI port.
#SCREEN="1280 800"
# 1080p: the scale factor (1080 / 800) is what keeps Engine from hanging.
#SCREEN="1920 1080"
#QT_SCALE_FACTOR=1.35
#CONNECTOR=HDMI-A-2

# A real controller to drive Engine with. This pair is the Denon MC6000MK2 on a
# Prime 4 G2 (JP24) rootfs; the option list comes from the header of
# shims/rk3588/controllermap/mappings/denon-mc6000mk2/JP24_Controller_Assignments.qml
#MIDI_FORWARD=MC6000MK2
#MIDI_FORWARD_ARGS="--pitchbend-cc 0x05,0x06 --relative-cc 0x51=0x37,0x4D --note-map 0:0x28=0x70 --note-map 1:0x62=0:0x62 --note-map 2:0x63=0:0x63 --note-map 3:0x63=0:0x63"
