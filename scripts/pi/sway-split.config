# sway-split.config — Engine beside two terminals, for a 2560x1440 output:
#
#   +----------------------+----------------------+
#   | Engine     1280x800  | foot       1280x800  |
#   +----------------------+----------------------+
#   | foot                             2560x640   |
#   +---------------------------------------------+
#
# Engine runs at its own size here, so start it at that size and without a
# scale factor:
#   sudo PLATFORM=wayland SCREEN="1280 800" QT_SCALE_FACTOR= qengine/chroot-engine.sh
# Floating windows, placed exactly: Engine hangs at any height but 800.

# The mode is pinned because the layout above is in pixels of it. Otherwise sway
# takes whatever mode the display prefers, and some displays change their
# preference between 1440p and 1080p from one connection to the next.
output * mode 2560x1440@60Hz
output * bg #000000 solid_color
default_border none
default_floating_border none
focus_follows_mouse no

for_window [app_id="Engine"] floating enable, resize set 1280 800, move position 0 0
for_window [app_id="qengine-right"] floating enable, resize set 1280 800, move position 1280 0
for_window [app_id="qengine-bottom"] floating enable, resize set 2560 640, move position 0 800

# foot otherwise sizes itself in whole character cells, and opens at its own
# default size before the rules above can resize it.
exec foot -o resize-by-cells=no --window-size-pixels=1280x800 --app-id=qengine-right
exec foot -o resize-by-cells=no --window-size-pixels=2560x640 --app-id=qengine-bottom

set $mod Mod4
bindsym $mod+Return exec foot
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exit
