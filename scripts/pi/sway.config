# sway.config — a sway for Engine to run in (PLATFORM=wayland in chroot-engine.sh).
# Start it as described in README.md, with WLR_RENDER_DRM_DEVICE set.
#
# Engine is made fullscreen and there is no bar: Engine lays out for a window
# 800 high and hangs at start-up at any other height, so QT_SCALE_FACTOR has to
# be the window's height over 800 -- which is only predictable if the window is
# the whole output.

# The mode is pinned because QT_SCALE_FACTOR (pi.env) has to be its height over
# 800. Otherwise sway takes whatever mode the display prefers, and some displays
# change their preference between 1440p and 1080p from one connection to the
# next. Change both together for another display.
output * mode 2560x1440@60Hz
output * bg #000000 solid_color
default_border none
for_window [app_id="Engine"] fullscreen enable

set $mod Mod4
bindsym $mod+Return exec foot
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exit
