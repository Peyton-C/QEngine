[Unit]
Description=RMZ2 virtual MIDI control surface (transport control + motor-off)
# Engine's MIDI enumerator binds devices during its own startup and does not
# pick one up afterwards, so the surface has to exist first.
Before=engine.service
After=controllermap.service

[Service]
Type=simple
# The fifo keeps the surface driveable by hand while it runs as a service:
#   echo 'play left' > /run/midisurface.fifo
#
# It lives in /run, not /root: this rootfs mounts / read-only, so creating it
# under /root fails outright at boot ("mkfifo: Read-only file system") and the
# service restart-loops. /run is tmpfs, always writable, and is where runtime
# state belongs anyway — it also means no stale fifo can survive a reboot.
#
# Held open read-write by the service itself so the surface never sees EOF when
# an interactive writer disconnects.
ExecStartPre=/bin/sh -c 'rm -f /run/midisurface.fifo && mkfifo /run/midisurface.fifo'
ExecStart=/bin/sh -c 'exec 3<>/run/midisurface.fifo; exec /root/midisurface RMZ2_Controller --motor-off < /run/midisurface.fifo'
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target