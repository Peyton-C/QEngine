[Unit]
# Per-head instance: %i is the virtio-gpu head number, 0-based.
#
# Head 0 is served by the non-templated touchbridge.service, so in practice
# only 1 and upwards are instantiated here. Both are enabled unconditionally by
# the rootfs build because the head count is a *runtime* property (GPU_MAX_OUTPUTS
# on the launcher) that the build cannot know.
#
# Deliberately no ExecCondition=: these units start before USB enumeration has
# finished, and a condition is evaluated exactly once. A first look that finds no
# tablet yet would make systemd *skip* the unit — and a skipped condition is not a
# failure, so Restart= never retries it and the head stays dead for the whole boot.
# The wait lives inside the program instead, which can tell "not enumerated yet"
# from "this guest has fewer displays" and exits 0 for the latter, so
# Restart=on-failure leaves it alone.
Description=QEMU tablet -> synthetic multitouch bridge (head %i)
Before=engine.service
DefaultDependencies=no
After=systemd-udevd.service

[Service]
Type=simple
ExecStart=/root/touchbridge --head %i
Restart=on-failure
RestartSec=1
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
